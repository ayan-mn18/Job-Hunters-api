# ---------------------------------------------------------------------------
# Job Hunters API — copy to `.env` and fill in.
# Nothing here has a real value checked in. The Supabase project does not exist
# yet; create it, then paste the credentials below.
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------
NODE_ENV=development
PORT=46460
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call this API.
# Huntly reserves 46461 for its Vite UI.
CORS_ORIGINS=http://localhost:46461,http://127.0.0.1:46461

# --- database ---------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI.
# Use the *session* pooler (port 5432) for migrations and the transaction
# pooler (port 6543) for the app if you deploy somewhere serverless.
# Remember to URL-encode the password if it contains special characters.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Supabase requires TLS. Set to "false" only when running a local plain Postgres.
DATABASE_SSL=true

# Max connections in the pg pool.
DATABASE_POOL_MAX=10

# --- queue ------------------------------------------------------------------
# Redis for BullMQ queues, distributed locks, and the daily job schedulers.
# Use a real Redis instance, not a per-request serverless one: BullMQ polls
# continuously and will exhaust a request-billed free tier in days.
# `docker compose up` provides one at this address.
REDIS_URL=redis://localhost:6379

# --- auth -------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# These MUST be different from each other and must not be committed.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=job-hunters-api

# bcrypt cost factor. 12 is a sane production default; drop to 10 locally if
# signup feels slow.
BCRYPT_ROUNDS=12

# --- supabase storage -------------------------------------------------------
# Supabase → Project Settings → API.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Service-role key. Server-side only — never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket that holds base resumes and generated variants.
SUPABASE_STORAGE_BUCKET=resumes
# How long a signed download URL stays valid, in seconds.
SUPABASE_SIGNED_URL_TTL=3600

# Master key. It does not encrypt credentials directly — it wraps a
# per-user data key held in `user_keys`, so rotating this only re-wraps that
# table rather than every stored secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORTAL_CREDENTIALS_KEY=

# Where Chromium is. Leave empty in the runner image — Playwright resolves the
# browser the image installed. On macOS this falls back to the local Chrome.
CHROMIUM_EXECUTABLE_PATH=

# Set by Dockerfile.runner. Adds --no-sandbox and the other flags Chromium
# needs to survive a container; leave false on a laptop.
BROWSER_IN_CONTAINER=false

# Opens a real browser window for interactive sign-in. Development only — a
# deployed host has no display.
AUTOMATION_HEADFUL=false

# Account creation and final submit stay disabled until explicitly enabled.
PORTAL_AUTOMATION_ENABLED=false

# --- job search APIs --------------------------------------------------------
# Tier 1: the connectors that search by keyword and location. Without at least
# one of these, discovery can only crawl company boards — it cannot act on the
# roles and locations the user actually asked for.
#
# Google for Jobs is the important one: it indexes LinkedIn, Naukri, Foundit,
# Bayt and Indeed postings, so those listings arrive here without a session and
# without scraping those sites. Either provider works; whichever key is set wins.
JSEARCH_API_KEY=
SERPAPI_KEY=

# Breadth, and a free tier of 1,000 calls a month. Covers India directly.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Covers the Gulf (UAE, Saudi, Qatar), which Adzuna does not.
JOOBLE_API_KEY=

# --- inbox ------------------------------------------------------------------
# Gmail, read-only. `gmail.readonly` is a Google *restricted* scope: a published
# app needs an annual CASA security assessment, but the OAuth consent screen's
# testing mode allows up to 100 manually added users for free. Start there and
# switch to the forwarding-address source before that ceiling matters.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:46461/inbox/callback

# --- models -----------------------------------------------------------------
# Without a key, model-backed features fall back to deterministic behaviour
# rather than failing. Every call is metered into `model_usage`.
ANTHROPIC_API_KEY=
MODEL_DEFAULT=claude-opus-5
# Per-purpose overrides. Empty means "use MODEL_DEFAULT".
MODEL_RERANK=
MODEL_CLASSIFY=
MODEL_DRAFT=
# Per-user monthly ceiling in USD. 0 disables the check.
MODEL_MONTHLY_BUDGET_USD=20

# --- uploads ----------------------------------------------------------------
MAX_RESUME_BYTES=5242880
MAX_PHOTO_BYTES=5242880

# --- rate limiting ----------------------------------------------------------
# Window in ms, and max requests per window, for /auth/* routes.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# --- misc -------------------------------------------------------------------
# Timezone used to bucket "today", referral days, and the streak counter.
APP_TIMEZONE=Asia/Kolkata
