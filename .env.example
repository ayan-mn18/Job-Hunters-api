# ---------------------------------------------------------------------------
# Job Hunters API — copy to `.env` and fill in.
# Nothing here has a real value checked in. The Supabase project does not exist
# yet; create it, then paste the credentials below.
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------
NODE_ENV=development
PORT=46460
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed to call this API.
# Huntly reserves 46461 for its Vite UI.
CORS_ORIGINS=http://localhost:46461,http://127.0.0.1:46461

# --- database ---------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI.
# Use the *session* pooler (port 5432) for migrations and the transaction
# pooler (port 6543) for the app if you deploy somewhere serverless.
# Remember to URL-encode the password if it contains special characters.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Supabase requires TLS. Set to "false" only when running a local plain Postgres.
DATABASE_SSL=true

# Max connections in the pg pool.
DATABASE_POOL_MAX=10

# --- queue ------------------------------------------------------------------
# Redis for BullMQ queues, distributed locks, and the daily job schedulers.
# Use a real Redis instance, not a per-request serverless one: BullMQ polls
# continuously and will exhaust a request-billed free tier in days.
# `docker compose up` provides one at this address.
REDIS_URL=redis://localhost:6379

# --- auth -------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# These MUST be different from each other and must not be committed.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=job-hunters-api

# bcrypt cost factor. 12 is a sane production default; drop to 10 locally if
# signup feels slow.
BCRYPT_ROUNDS=12

# --- supabase storage -------------------------------------------------------
# Supabase → Project Settings → API.
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Service-role key. Server-side only — never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket that holds base resumes and generated variants.
SUPABASE_STORAGE_BUCKET=resumes
# How long a signed download URL stays valid, in seconds.
SUPABASE_SIGNED_URL_TTL=3600

# Master key. It does not encrypt credentials directly — it wraps a
# per-user data key held in `user_keys`, so rotating this only re-wraps that
# table rather than every stored secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PORTAL_CREDENTIALS_KEY=

# Where Chromium is, for BROWSER_PROVIDER=local only. Leave empty in the runner
# image — Playwright resolves the browser the image installed. On macOS this
# falls back to the local Chrome.
CHROMIUM_EXECUTABLE_PATH=

# Set by Dockerfile.runner. Adds --no-sandbox and the other flags Chromium
# needs to survive a container; leave false on a laptop.
BROWSER_IN_CONTAINER=false

# Opens a real browser window for interactive sign-in. Only meaningful with
# BROWSER_PROVIDER=local. With the hosted provider a user signs in by clicking
# inside the session's live view, which needs no display on this host.
AUTOMATION_HEADFUL=false

# Account creation and final submit stay disabled until explicitly enabled.
PORTAL_AUTOMATION_ENABLED=false

# Fills every field, screenshots the result, and stops before submitting. On
# by default: turning it off is what sends real applications to real
# employers, and that should be a deliberate act, not an inherited default.
APPLY_DRY_RUN=true
# Stops every application immediately, without a redeploy.
APPLY_KILL_SWITCH=false
# How long a blocked attempt waits for a human before parking, in ms.
APPLY_TAKEOVER_WINDOW_MS=300000
# Low-memory deployments should start with one browser job at a time. Capped at
# BROWSER_MAX_CONCURRENT_SESSIONS below: allowing more only moves the queueing
# into openSession, where a job waits while holding its BullMQ lock.
RUNNER_APPLY_CONCURRENCY=1

# --- job search APIs --------------------------------------------------------
# Tier 1: the connectors that search by keyword and location. Without at least
# one of these, discovery can only crawl company boards — it cannot act on the
# roles and locations the user actually asked for.
#
# Google for Jobs is the important one: it indexes LinkedIn, Naukri, Foundit,
# Bayt and Indeed postings, so those listings arrive here without a session and
# without scraping those sites. Either provider works; whichever key is set wins.
JSEARCH_API_KEY=
SERPAPI_KEY=

# Breadth, and a free tier of 1,000 calls a month. Covers India directly.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Covers the Gulf (UAE, Saudi, Qatar), which Adzuna does not.
JOOBLE_API_KEY=

# --- inbox ------------------------------------------------------------------
# Gmail, read-only. `gmail.readonly` is a Google *restricted* scope: a published
# app needs an annual CASA security assessment, but the OAuth consent screen's
# testing mode allows up to 100 manually added users for free. Start there and
# switch to the forwarding-address source before that ceiling matters.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail callback. Must exactly match a redirect URI registered on this OAuth
# client in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT=http://localhost:46461/app
# Optional alias for Gmail. Leave unset to use GOOGLE_OAUTH_REDIRECT.
GOOGLE_GMAIL_REDIRECT=
# Login callback. `/app` is already registered for the Gmail flow; the UI
# preserves the OAuth query while redirecting signed-out users to `/login`.
GOOGLE_AUTH_REDIRECT=http://localhost:46461/app

# --- payments ---------------------------------------------------------------
# Dodo is intentionally disabled until the product, webhook and legal flows
# are verified. Use the test API base while building; never point this at live
# until the enable switch is deliberately changed.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com
DODO_PAYMENTS_ENABLED=false
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_RETURN_URL=http://localhost:46461/app

# --- models -----------------------------------------------------------------
# Without a key, model-backed features fall back to deterministic behaviour
# rather than failing. Every call is metered into `model_usage`.
ANTHROPIC_API_KEY=
# Only for an identity-linked API key (one console account with access to
# several workspaces) — Anthropic then needs the target workspace named
# explicitly. Leave blank for a workspace's own key.
ANTHROPIC_WORKSPACE_ID=
MODEL_DEFAULT=claude-opus-5
# Per-purpose overrides. Empty means "use MODEL_DEFAULT".
MODEL_RERANK=
MODEL_CLASSIFY=
MODEL_DRAFT=
# Per-user monthly ceiling in USD. 0 disables the check.
MODEL_MONTHLY_BUDGET_USD=20

# --- outgoing mail ----------------------------------------------------------
# Run confirmations are sent here, to the address on the user's Kit. Plain SMTP
# rather than sending through their own Gmail: that needs `gmail.send`, a second
# restricted scope and a second consent screen, for one message. Works with a
# Gmail app password, SES, Postmark or anything else that speaks SMTP.
#
# Without SMTP_HOST the confirmation is logged and skipped, and the application
# it describes still stands.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Hunty <hunty@huntly.app>

# --- uploads ----------------------------------------------------------------
MAX_RESUME_BYTES=5242880
MAX_PHOTO_BYTES=5242880

# --- rate limiting ----------------------------------------------------------
# Window in ms, and max requests per window, for /auth/* routes.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# --- misc -------------------------------------------------------------------
# Timezone used to bucket "today", referral days, and the streak counter.
APP_TIMEZONE=Asia/Kolkata

# --- providers --------------------------------------------------------------
# Three services carry the engine: Muse Spark reasons, Browser Use supplies
# every browser, Firecrawl reads every page that needs no login.

# Which provider reasons. "muse" is the default and needs META_API_KEY below.
# "anthropic" is the fallback path, kept because a single provider going down
# would otherwise take out rerank, classification, drafting and applying at
# once.
MODEL_PROVIDER=muse
MUSE_MODEL=muse-spark-1.3-contributor

# Muse Spark, through Meta's OpenAI-compatible Model API. It is a reasoning
# model and most of its spend is thinking — a one-word reply measured 143
# reasoning tokens — so give max_tokens real headroom or answers come back
# empty rather than truncated.
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# Where browsers come from. "browser-use" is a hosted Chromium driven over CDP
# by this project's own Playwright code: stealth, proxies, CAPTCHA solving, a
# per-user profile that keeps a login alive between runs, and a live URL a
# human can take over in. Without a key this falls back to "local".
BROWSER_PROVIDER=browser-use
BROWSER_USE_API_KEY=
BROWSER_USE_API_BASE=https://api.browser-use.com/api/v4
# Two-letter country for the managed residential proxy, or empty for a direct
# connection. Empty by default: managed egress is $5/GB against $0.20/GB
# direct, and most application forms do not care where the request came from.
# Sites that do care ask for a proxy in their own skill manifest.
BROWSER_USE_PROXY_COUNTRY=
# Minutes before a hosted session self-terminates. Also the billing ceiling on
# a session nobody closed.
BROWSER_SESSION_TIMEOUT_MIN=15
# How many browsers may exist at once, across the whole process — applying,
# LinkedIn outreach, the referral sync and interactive sign-in all draw on this
# one pool. Browser Use itself refuses the eleventh concurrent session until a
# lifetime spend threshold is passed, so this stays well under that. Counted
# per process: two runner replicas at 4 is 8 browsers, not 4.
BROWSER_MAX_CONCURRENT_SESSIONS=4
# Hands a twice-failed flow to Browser Use's own managed agent. Leave false:
# that agent reasons with a model from their list, not with Muse Spark.
BROWSER_USE_MANAGED_FALLBACK=false

# Firecrawl reads job boards with no API, company career pages, and posting
# detail pages. Discovery keeps its documented JSON connectors either way —
# this only covers the sources that would otherwise be scraped by hand.
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE=https://api.firecrawl.dev/v2

# --- agent loop -------------------------------------------------------------
# The browser agent: Muse Spark decides each step, Playwright performs it.
APPLY_AGENT_MODEL=muse-spark-1.3-contributor
APPLY_AGENT_MAX_TOKENS=8000
APPLY_AGENT_MAX_STEPS=18
# Ceiling on a single step. Without one a stalled step parks an application in
# `applying` forever: apply jobs are queued with attempts: 1 and no timeout.
APPLY_AGENT_STEP_TIMEOUT_MS=90000
APPLY_RECOVERY_ATTEMPTS=3
